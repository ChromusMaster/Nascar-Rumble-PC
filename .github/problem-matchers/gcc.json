{
  "problemMatcher": [
    {
      "owner": "nr-gcc",
      "pattern": [
        {
          "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "nr-ubsan",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+runtime error:\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
